{
  "name": "@synergyconnectapp/sdk",
  "version": "1.0.0",
  "description": "SDK oficial da API pública do Synergy Connect (WhatsApp): mensagens, mídia, flows, handoff e verificação de webhooks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synergyconnectapp/synergy-node.git"
  },
  "homepage": "https://github.com/synergyconnectapp/synergy-node#readme",
  "bugs": {
    "url": "https://github.com/synergyconnectapp/synergy-node/issues"
  },
  "keywords": [
    "synergy",
    "synergy-connect",
    "whatsapp",
    "sdk",
    "webhooks"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "webhooks": [
        "./dist/webhooks.d.ts"
      ],
      "errors": [
        "./dist/errors.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:contract": "node scripts/contract.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
