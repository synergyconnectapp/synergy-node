{
  // Tests and configs run on Node: they get its types. `src/` (tsconfig.json) never does: the SDK has no `node:` at runtime.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src", "test", "tsdown.config.ts", "vitest.config.ts", "vitest.contract.config.ts", "vitest.live.config.ts"]
}
